                    </HBox>

                    <HBox alignItems="Start"  class="sapUiSmallMarginBottom">
                        <VBox width="2.5rem" alignItems="Center" class="sapUiSmallMarginEnd">
                            <core:Icon src="sap-icon://money-bills"
                                color="{= ((${context>/Approver14Name} || '').toUpperCase() !== 'NONAPPROVE') ? '#27500A' : '#888780' }"
                                size="1.2rem" />
                        </VBox>
                        <VBox>
                            <Text text="ผู้จ่ายเงิน กง." class="labelGrey" />
                            <Text text="{= ((${context>/Approver14Name} || '').toUpperCase() === 'NONAPPROVE') ? '-' : ${context>/Approver14Name} }" class="valueBlue" />
                            <Text text="{= ((${context>/Approver14Name} || '').toUpperCase() === 'NONAPPROVE') ? '' : (${context>/Approver14Comment} ? 'Comment: ' + ${context>/Approver14Comment} : 'Comment: -') }" 
                                class="labelGrey" visible="{= ((${context>/Approver14Name} || '').toUpperCase() !== 'NONAPPROVE') }" />
                            <ObjectStatus
                                visible="{= !!${context>/Approver14Name} &amp;&amp; ((${context>/Approver14Name} || '').toUpperCase() !== 'NONAPPROVE') }"
                                text="อนุมัติแล้ว"
                                icon="sap-icon://accept"
                                state="Success" />
                            <ObjectStatus
                                visible="{= !${context>/Approver14Name} &amp;&amp; ((${context>/Approver14Name} || '').toUpperCase() !== 'NONAPPROVE') }"
                                text="รอดำเนินการ"
                                state="None" />
                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </Panel>
    </VBox>
</mvc:View>